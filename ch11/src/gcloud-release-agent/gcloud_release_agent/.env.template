# gcloud-release-agent/gcloud_release_agent/.env
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=TRUE

# デプロイ後に、出力された Agent Engine のフルパスを設定してコメントを外してください
# 注意: デプロイ前に AGENT_ENGINE_ID を空の値で定義していると adk deploy が失敗します
# AGENT_ENGINE_ID=projects/YOUR_PROJECT_ID/locations/us-central1/reasoningEngines/XXXXXXXXXX
